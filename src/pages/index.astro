---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedPosts, groupPostsByYear } from '../lib/writings';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import PostCard from '../components/PostCard.astro';

const posts = await getSortedPosts();
const recent = posts.slice(0, 5);

const groupedRecent = groupPostsByYear(recent);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <article class="prose mb-12">
    <h1 class="text-2xl font-semibold tracking-tight text-(--color-text) mb-3">
      Hi, I'm Toheeb
    </h1>

    <p>
      I build software, companies and AI tools.
    </p>

    <p>
      I write about the things I notice, questions I keep thinking about and ideas that stay with me.
    </p>
    <p>
      Sometimes that means technology and what I'm building. Sometimes it's books, people, places or an ordinary evening that turned out to be less ordinary than I expected.
    </p>
    <p>
      I'm interested in freedom, curiosity and the responsibility that comes with building things.
    </p>

    <p>
      This is my personal corner on the internet. Enjoy 🎉
    </p>

    <p class="text-(--color-text-muted)">
      You can reach me at{' '}
      <a href="mailto:hello@creativenux.com">hello@creativenux.com</a>.
    </p>
  </article>

  <section>
    <h2 class="text-lg font-semibold text-(--color-text) mb-4">Recent writings</h2>
    <div>
      {groupedRecent.length > 0 ? (
        groupedRecent.map((group) => (
          <div class="grid grid-cols-[4rem_1fr] gap-x-6 border-t border-(--color-border) py-2.5 first:border-t-0">
            <p class="text-sm text-(--color-text-muted) pt-2">{group.year}</p>
            <div class="divide-y-0">
              {group.posts.map((post) => (
                <PostCard
                  slug={post.id}
                  title={post.data.title}
                  date={post.data.date}
                />
              ))}
            </div>
          </div>
        ))
      ) : (
        <p class="text-(--color-text-muted) py-6">No writings yet. Check back soon.</p>
      )}
    </div>
    {posts.length > 5 && (
      <p class="mt-6">
        <a href="/writings" class="text-sm font-medium hover:underline">
          View all writings →
        </a>
      </p>
    )}
  </section>
</BaseLayout>
